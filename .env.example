# Copy to .env.local and fill in. Only needed for the optional server-side fallbacks.

# Hugging Face token used by the server actions (embed / summarize) when the
# user opts into server fallback. Server-only: never prefix with NEXT_PUBLIC_.
# Without it, the fallbacks return a "not configured" error; local inference still works.
HF_API_TOKEN=

# Embedding model, run on-device with transformers.js. Multilingual (EN + PT-BR),
# ~118 MB download. Changing it re-indexes all notes (old vectors are dropped).
# Needs query/document prefixes for e5-style models (set automatically for ids
# containing "e5"; override below if your model needs others, empty string = none).
# Models whose ONNX export returns a pooled `sentence_embedding` (e.g. EmbeddingGemma)
# are NOT supported by the feature-extraction pipeline used here.
NEXT_PUBLIC_EMBEDDING_MODEL_ID=Xenova/multilingual-e5-small
NEXT_PUBLIC_EMBEDDING_DTYPE=q8
# NEXT_PUBLIC_EMBEDDING_QUERY_PREFIX="query: "
# NEXT_PUBLIC_EMBEDDING_DOCUMENT_PREFIX="passage: "

# Hosted copy of the SAME embedding model for the server fallback. It must be the
# same underlying model as above, or the fallback vectors are not comparable.
SERVER_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# On-device summarization model (transformers.js, ONNX). Default is Qwen3-0.6B (~570 MB at q4f16,
# thinking disabled). Higher quality but ~4x the download: onnx-community/Phi-3.5-mini-instruct-onnx-web.
# Do not use single-file models above ~1.3 GB (Qwen3-1.7B, 1.4 GB, fails with bad_alloc in the
# browser, confirmed in both the in-app browser and desktop Chrome) or Qwen2.5-1.5B q4f16
# (garbage output on WebGPU). See docs/model-eval.md.
NEXT_PUBLIC_SUMMARIZATION_MODEL_ID=onnx-community/Qwen3-0.6B-ONNX
NEXT_PUBLIC_SUMMARIZATION_DTYPE=q4f16

# Server-side summarization model (Hugging Face Inference).
SERVER_SUMMARIZER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Semantic search tuning.
NEXT_PUBLIC_DEFAULT_SEMANTIC_SEARCH_TOP_K=12
NEXT_PUBLIC_DEFAULT_SEMANTIC_SEARCH_OVERSAMPLING_FACTOR=2
