# Copy to .env.local and fill in. Only needed for the optional server-side fallbacks.

# Hugging Face token used by the server actions (embed / summarize) when the
# user opts into server fallback. Server-only: never prefix with NEXT_PUBLIC_.
# Without it, the fallbacks return a "not configured" error; local inference still works.
HF_API_TOKEN=

# Embedding model (used on-device AND by the server fallback; must match).
NEXT_PUBLIC_EMBEDDING_MODEL_ID=Supabase/gte-small

# On-device summarization model (transformers.js, ONNX web build).
NEXT_PUBLIC_SUMMARIZATION_MODEL_ID=onnx-community/Phi-3.5-mini-instruct-onnx-web

# Server-side summarization model (Hugging Face Inference).
SERVER_SUMMARIZER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Semantic search tuning.
NEXT_PUBLIC_DEFAULT_SEMANTIC_SEARCH_TOP_K=12
NEXT_PUBLIC_DEFAULT_SEMANTIC_SEARCH_OVERSAMPLING_FACTOR=2
